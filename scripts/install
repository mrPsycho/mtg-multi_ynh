#!/bin/bash

#=================================================
# COMMON VARIABLES AND HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

version=$(ynh_read_manifest "version")

#=================================================
# FETCH AND INSTALL MTG-MULTI BINARY
#=================================================
ynh_script_progression "Setting up source files..."

ynh_setup_source --dest_dir="$install_dir"

chmod +x "$install_dir/mtg-multi"
chown "$app:$app" "$install_dir/mtg-multi"

mkdir -p "$install_dir/conf" "$install_dir/www"
chown "$app:$app" "$install_dir/conf" "$install_dir/www"
chmod 700 "$install_dir/conf"

mkdir -p "/var/log/$app"
chown -R "$app:$app" "/var/log/$app"

#=================================================
# GENERATE ONE SECRET PER YUNOHOST USER
#=================================================
ynh_script_progression "Generating one MTProto secret per user..."

mtg_sync_secrets

#=================================================
# WRITE CONFIGURATION
#=================================================
ynh_script_progression "Adding $app's configuration files..."

mtg_add_config

#=================================================
# SETUP WEB INTERFACE (index.php + php-fpm + nginx)
#=================================================
ynh_script_progression "Setting up web interface..."

ynh_config_add --template="index.php" --destination="$install_dir/www/index.php"
chown "$app:$app" "$install_dir/www/index.php"

ynh_config_add_phpfpm
ynh_config_add_nginx

#=================================================
# SYSTEMD + SERVICE REGISTRATION
#=================================================
ynh_script_progression "Setting up systemd service..."

ynh_config_add_systemd
mtg_add_reload_units
ynh_config_add_logrotate "/var/log/$app/$app.log"

yunohost service add "$app" \
    --description "MTProto proxy for Telegram (mtg-multi)" \
    --needs_exposed_ports "$port" \
    --log="/var/log/$app/$app.log"

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

ynh_systemctl --action=enable
ynh_systemctl --action=start

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Installation of $app completed"
