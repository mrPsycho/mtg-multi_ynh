#!/bin/bash

#=================================================
# COMMON VARIABLES AND HELPERS
#=================================================

source /usr/share/yunohost/helpers

conf_dir=$install_dir/conf

#=================================================
# STOP SERVICE
#=================================================
ynh_script_progression "Stopping $app's systemd service..."

ynh_systemctl --action=stop

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Upgrading source files..."

# $install_dir is set automatically from [resources.install_dir]
ynh_setup_source --dest_dir="$install_dir" --full_replace --keep="conf"

chmod +x "$install_dir/mtg-multi"
chown "$app:" "$install_dir/mtg-multi"

# Remove old mtg binary if present (migration from original mtg)
if [ -f "$install_dir/mtg" ]; then
    ynh_print_info "Removing old mtg binary (migrating to mtg-multi)..."
    rm -f "$install_dir/mtg"
fi

#=================================================
# PRESERVE OR GENERATE SECRET
#=================================================
ynh_script_progression "Checking MTProto secret..."

# Try to read existing secret from the current config
# Supports both formats:
#   old: <base64secret> = "DefaultSecretReplaceMe"
#   new: "default" = "<base64secret>"
if [ -f "$conf_dir/mtg.toml" ]; then
    # First try new format: "key" = "value" (only in [secrets] section)
    existing_secret=$(sed -n '/^\[secrets\]/,/^\[/{/^\[secrets\]/!p}' "$conf_dir/mtg.toml" | grep -oP '^\s*"[^"]*"\s*=\s*"\K[^"]+' | head -n1)
    # If that looks like a placeholder, try old format: key = "value"
    if [ -z "$existing_secret" ] || [ "$existing_secret" = "DefaultSecretReplaceMe" ]; then
        existing_secret=$(grep -oP '^\s*\S+\s*=\s*"\K[^"]+' "$conf_dir/mtg.toml" | head -n1)
    fi
fi

if [ -n "$existing_secret" ] && [ "$existing_secret" != "DefaultSecretReplaceMe" ]; then
    # Keep the existing valid secret
    secret="$existing_secret"
    ynh_print_info "Preserving existing secret"
else
    # No valid secret found — use default fake secret
    ynh_print_info "No valid secret found — using default fake secret (replace it later!)"
    secret="DefaultSecretReplaceMe"
fi

#=================================================
# UPDATE A CONFIG FILE
#=================================================
ynh_script_progression "Updating $app's configuration files..."

[ "$prometheus" = "1" ] && prom_enabled="true" || prom_enabled="false"

# Generate config via ynh_config_add (replaces __PORT__, __DNS__, __PROM_ENABLED__)
# then inject secret via sed to avoid issues with '=' in base64 secrets
# !!!SECRET!!! is used instead of __SECRET__ to avoid ynh_config_add from processing it
ynh_config_add --template="mtg.toml" --destination="$conf_dir/mtg.toml"
sed -i "s|!!!SECRET!!!|$secret|g" "$conf_dir/mtg.toml"

# Ensure log directory exists
mkdir -p /var/log/$app
chown $app: /var/log/$app

#=================================================
# UPDATE WEB INTERFACE (index.php + nginx)
#=================================================
ynh_script_progression "Updating web interface..."

# Copy the status page
cp "$conf_dir/index.php" "$install_dir/index.php"
chown "$app:" "$install_dir/index.php"

# Update nginx configuration
ynh_config_add_nginx

#=================================================
# UPDATE SYSTEMD CONFIG
#=================================================

ynh_config_add_systemd

yunohost service add "$app" \
    --description "MTProto proxy for Telegram (mtg-multi)" \
    --needs_exposed_ports "$port" \
    --log="/var/log/$app/mtg.log"

# Open port in firewall
ynh_script_progression "Opening port $port in firewall..."
yunohost firewall allow Both "$port" 2>&1 || ynh_print_warn "Could not open port $port in firewall"

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

ynh_systemctl --action=start

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Upgrade of $app completed"
