#!/bin/bash

#=================================================
# COMMON VARIABLES AND HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

version=$(ynh_read_manifest "version")

#=================================================
# STOP SERVICE
#=================================================
ynh_script_progression "Stopping $app's systemd service..."

ynh_systemctl --action=stop

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Upgrading source files..."

ynh_setup_source --dest_dir="$install_dir" --full_replace --keep="conf"

chmod +x "$install_dir/mtg-multi"
chown "$app:$app" "$install_dir/mtg-multi"

# Leftovers from the pre-multi-user layout
ynh_safe_rm "$install_dir/mtg"
ynh_safe_rm "$install_dir/index.php"

mkdir -p "$install_dir/conf" "$install_dir/www"
chown "$app:$app" "$install_dir/conf" "$install_dir/www"
chmod 700 "$install_dir/conf"

mkdir -p "/var/log/$app"
chown -R "$app:$app" "/var/log/$app"

#=================================================
# SYNC SECRETS WITH THE CURRENT USER LIST
#=================================================
ynh_script_progression "Synchronizing per-user MTProto secrets..."

mtg_sync_secrets

#=================================================
# UPDATE A CONFIG FILE
#=================================================
ynh_script_progression "Updating $app's configuration files..."

mtg_add_config

#=================================================
# UPDATE WEB INTERFACE (index.php + php-fpm + nginx)
#=================================================
ynh_script_progression "Updating web interface..."

ynh_config_add --template="index.php" --destination="$install_dir/www/index.php"
chown "$app:$app" "$install_dir/www/index.php"

ynh_config_add_phpfpm
ynh_config_add_nginx

mtg_add_hooks

#=================================================
# UPDATE SYSTEMD CONFIG
#=================================================

ynh_config_add_systemd
ynh_config_add_logrotate "/var/log/$app/$app.log"

yunohost service add "$app" \
    --description "MTProto proxy for Telegram (mtg-multi)" \
    --needs_exposed_ports "$port" \
    --log="/var/log/$app/$app.log"

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

ynh_systemctl --action=start

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Upgrade of $app completed"
