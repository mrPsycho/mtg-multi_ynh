#!/bin/bash

#=================================================
# COMMON VARIABLES AND HELPERS
#=================================================

source /usr/share/yunohost/helpers

#=================================================
# RESTORE THE APP MAIN DIR
#=================================================
ynh_script_progression "Restoring the app main directory..."

ynh_restore "$install_dir"

#=================================================
# RESTORE NGINX CONFIGURATION
#=================================================
ynh_script_progression "Restoring nginx configuration..."

# Get the first YunoHost domain for the nginx config
domain=$(yunohost domain list --output-as json 2>/dev/null | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('domains',[])[0])" 2>/dev/null)
if [ -z "$domain" ]; then
    ynh_print_warn "No domain found, skipping nginx configuration"
else
    # Set path for the nginx template (service apps use root path)
    path="/"
    nginx_conf_path="/etc/nginx/conf.d/$domain.d/$app.conf"
    mkdir -p "/etc/nginx/conf.d/$domain.d"
    ynh_config_add --template="nginx.conf" --destination="$nginx_conf_path"
    ynh_store_file_checksum "$nginx_conf_path"
    ynh_systemctl --service=nginx --action=reload
fi

#=================================================
# RESTORE SYSTEM CONFIGURATIONS
#=================================================
ynh_script_progression "Restoring system configurations related to $app..."

ynh_config_add_systemd

yunohost service add "$app" \
    --description "MTProto proxy for Telegram" \
    --needs_exposed_ports "$port" \
    --log="/var/log/$app/mtg.log"

#=================================================
# RELOAD THE APP SERVICE
#=================================================
ynh_script_progression "Reloading $app's service..."

ynh_systemctl --action=enable
ynh_systemctl --action=start

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Restoration completed for $app"
